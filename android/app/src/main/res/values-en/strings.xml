    <string name="compress_entry">Compress to HEVC</string>
    <string name="compress_entry_sub" formatted="false">Nearly the same quality, usually 30–50% smaller</string>
    <string name="compress_title">Compress videos</string>
    <string name="compress_explain1">Re-encodes with the phone\'s HEVC (H.265) encoder at nearly the same quality. Videos already in HEVC, or that would not get smaller, are skipped.</string>
    <string name="compress_explain2">The new video goes in the same folder and keeps the original date and location. The original goes into your delete list and is only removed after you confirm. Keep the app open while compressing.</string>
    <string name="compress_unsupported">This phone has no HEVC encoder or runs below Android 10.</string>
    <string name="compress_button">Compress %1$d selected (%2$s)</string>
    <string name="motion_explain1">Motion photos contain a short video clip. Converting keeps only the still image at the same quality.</string>
    <string name="motion_explain2">The still goes in the same folder with the same date; the original goes into your delete list and is only removed after you confirm.</string>
